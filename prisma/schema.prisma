// ============================================================
// schema.prisma — modèle de données pour le vrai projet
// Reprend fidèlement la structure de l'artifact (bankrolls, paris,
// objectifs, insights) pour une migration directe.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // URL de connexion Supabase (avec pooling, port 6543)
  directUrl = env("DIRECT_URL") // connexion directe (port 5432), utilisée par les migrations
}

// ------------------------------------------------------------
// Utilisateur
// ------------------------------------------------------------
// L'id correspond à l'id renvoyé par Supabase Auth (uuid) — pas de
// mot de passe stocké ici, l'auth reste gérée par Supabase.
model User {
  id        String   @id // = auth.users.id de Supabase
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // Parrainage bêta : le code est créé avec le profil, tandis que la relation
  // de parrainage reste irréversible et entièrement gérée côté serveur.
  referralCode        String  @unique
  referralScanCredits Int     @default(0)

  // Objectifs (équivalent du champ "goals" persisté dans l'artifact)
  monthlyProfitGoal Float @default(0)
  monthlyLossLimit  Float @default(0)

  // Rate limiting du scan IA (fenêtre glissante, cf. checkScanRateLimit) —
  // chaque appel coûte réellement de l'argent (API Claude), à limiter par
  // utilisateur indépendamment des instances serverless.
  scanCount       Int      @default(0)
  scanWindowStart DateTime @default(now())

  // Devise d'affichage — cosmétique uniquement, aucune conversion réelle.
  // Les montants restent stockés tels quels (implicitement en euros) ;
  // ce champ ne fait que changer le symbole/code affiché côté UI.
  currency Currency @default(EUR)

  // Abonnement Stripe — plan FREE par défaut ; les champs stripe* restent
  // null tant que l'utilisateur n'a jamais entamé de checkout. Le webhook
  // (/api/stripe/webhook) est la seule source de vérité qui les met à jour,
  // jamais l'UI directement.
  plan                          Plan      @default(FREE)
  stripeCustomerId              String?   @unique
  stripeSubscriptionId          String?   @unique
  subscriptionStatus            String?
  subscriptionCurrentPeriodEnd  DateTime?
  // La remise bêta Stripe ne doit être utilisée qu'une seule fois par
  // utilisateur, même après une résiliation suivie d'une nouvelle souscription.
  betaOfferUsedAt               DateTime?

  // Crédits ponctuels accordés à l'abonnement pour l'import d'historique.
  // Ils sont consommés avant le quota mensuel et expirent 30 jours après
  // l'abonnement, sans jamais être recréés par les webhooks du cycle de vie.
  initialScanCreditRemaining Int      @default(0)
  initialScanCreditExpiresAt DateTime?
  initialScanCreditGrantedAt DateTime?

  // Quota mensuel de scans IA lié au plan —
  // fenêtre glissante indépendante du rate-limit horaire anti-abus
  // (scanCount/scanWindowStart ci-dessus, qui reste inchangé).
  monthlyScanCount       Int      @default(0)
  monthlyScanWindowStart DateTime @default(now())

  bankrolls Bankroll[]
  insight   Insight?
  scanUsages ScanUsage[]
  referredBy Referral? @relation("ReferredUser")
  referrals Referral[] @relation("Referrer")
  referralRewards ReferralReward[]
  feedbacks Feedback[]
  taxonomyEntries UserTaxonomyEntry[]
  scanQualityReports ScanQualityReport[]
  redeemedBetaInvite BetaInvite?
  betaInviteRedemptions BetaInviteRedemption[]

  @@map("users")
}

enum Currency {
  EUR
  USD
  GBP
}

enum Plan {
  FREE
  BETA_TESTER
  BETA_PREMIUM
  PREMIUM
}

enum BetaPhase {
  ACTIVE
  ENDED
}

enum BookmakerSupportStatus {
  TESTED
  UNTESTED
  VALIDATING
}

enum ScanQualityReportStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
  RESOLVED
}

enum ScanQualityIssueType {
  INCORRECT
  INCOMPLETE
  OTHER
}

// ------------------------------------------------------------
// Bankroll
// ------------------------------------------------------------
model Bankroll {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  bookmaker String
  initial   Float    @default(0) // capital de départ
  createdAt DateTime @default(now())

  bets      Bet[]
  movements BankrollMovement[]
  scanQualityReports ScanQualityReport[]

  @@index([userId])
  @@map("bankrolls")
}

enum BankrollMovementType {
  DEPOSIT
  WITHDRAWAL
}

// Entrées et sorties de fonds distinctes des résultats de paris. Le capital
// initial reste immutable dans les statistiques : les mouvements ultérieurs
// expliquent précisément les variations de solde hors performance sportive.
model BankrollMovement {
  id         String               @id @default(uuid())
  bankrollId String
  bankroll   Bankroll             @relation(fields: [bankrollId], references: [id], onDelete: Cascade)
  type       BankrollMovementType
  amount     Float
  note       String?
  date       DateTime             @default(now())
  createdAt  DateTime             @default(now())

  @@index([bankrollId, date])
  @@map("bankroll_movements")
}

// ------------------------------------------------------------
// Résultat d'un pari
// ------------------------------------------------------------
enum BetResult {
  EN_ATTENTE
  GAGNE
  PERDU
  REMBOURSE
  CASHE
}

// ------------------------------------------------------------
// Pari
// ------------------------------------------------------------
// sport et betType restent des String libres (pas des enums) —
// exactement comme dans l'artifact : la taxonomie (SPORTS, types de
// paris) vit côté application (constante JS/TS) et peut évoluer sans
// migration de base de données. Le résultat, lui, est un enum fixe
// car il conditionne des calculs (computeProfit) qui ne doivent pas
// dériver silencieusement si quelqu'un tape une valeur inattendue.
model Bet {
  id         String    @id @default(uuid())
  bankrollId String
  bankroll   Bankroll  @relation(fields: [bankrollId], references: [id], onDelete: Cascade)

  ticketRef  String?   // référence du ticket bookmaker, pour la dédup
  date       DateTime
  sport      String
  betType    String
  description String?
  eventResult String? // score/résultat de l'événement, distinct de la sélection jouée

  stake      Float
  odds       Float

  boosted      Boolean @default(false)
  originalOdds Float?  // cote avant boost, si boosted=true

  freebet    Boolean   @default(false)
  live       Boolean   @default(false)

  result        BetResult @default(EN_ATTENTE)
  cashOutAmount Float?    // montant encaissé si result = CASHE

  createdAt  DateTime  @default(now())

  @@index([bankrollId])
  @@index([ticketRef])
  @@map("bets")
}

// ------------------------------------------------------------
// Taxonomie personnelle
// ------------------------------------------------------------
// Les sports et types standards restent dans src/lib/sports.ts. Cette table
// ne contient que les couples ajoutés depuis les tickets d'UN utilisateur :
// elle ne peut donc jamais modifier les suggestions d'un autre compte.
model UserTaxonomyEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport     String
  betType   String
  createdAt DateTime @default(now())

  @@unique([userId, sport, betType])
  @@index([userId, sport])
  @@map("user_taxonomy_entries")
}

// ------------------------------------------------------------
// Consommation Anthropic par analyse d'image
// ------------------------------------------------------------
// Les coûts sont figés au moment de l'appel : le tableau de bord admin reste
// donc exact même si le tarif de Haiku change plus tard.
model ScanUsage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  model        String
  plan         Plan     @default(FREE)
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  // Empêche qu'une même capture soit traitée plusieurs fois pour le
  // parrainage. Les valeurs nulles des anciennes lignes restent autorisées.
  sourceHash   String?
  referralEligible    Boolean   @default(false)
  referralProcessedAt DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@unique([userId, sourceHash])
  @@map("scan_usages")
}

// Une relation directe, sans niveau supplémentaire : un filleul n'a qu'un
// parrain et chaque utilisateur peut suivre les personnes qu'il a invitées.
model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser   User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  validScanCount Int      @default(0)
  firstValidScanAt DateTime?
  fifthValidScanAt DateTime?
  suspiciousAt   DateTime?
  suspiciousReason String?
  rewards        ReferralReward[]
  createdAt      DateTime @default(now())

  @@unique([referrerId, referredUserId])
  @@index([referrerId, createdAt])
  @@index([suspiciousAt])
  @@map("referrals")
}

enum ReferralRewardType {
  REFEREE_FIRST_VALID_SCAN
  REFERRER_FIRST_VALID_SCAN
  REFERRER_FIFTH_VALID_SCAN
  // Prévu pour la version finale, sans règle de paiement activée en bêta.
  REFERRER_SUBSCRIPTION_PAYMENT
}

enum ReferralRewardStatus {
  GRANTED
  CANCELLED
}

// Grand livre auditable des gains de scans. triggerKey rend chaque déclencheur
// strictement idempotent, même si une requête est rejouée.
model ReferralReward {
  id                 String               @id @default(uuid())
  beneficiaryId      String
  beneficiary        User                 @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  referralId         String
  referral           Referral             @relation(fields: [referralId], references: [id], onDelete: Cascade)
  amount             Int
  type               ReferralRewardType
  triggerKey         String               @unique
  status             ReferralRewardStatus @default(GRANTED)
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())

  @@index([beneficiaryId, createdAt])
  @@index([referralId, createdAt])
  @@map("referral_rewards")
}

// Une seule ligne de configuration pilote la période bêta. Les invitations
// sont à usage unique et leur jeton n'est jamais conservé en clair.
model BetaProgram {
  id        String    @id @default("global")
  phase     BetaPhase @default(ACTIVE)
  endedAt   DateTime?
  endedBy   String?
  updatedAt DateTime  @updatedAt

  @@map("beta_program")
}

model BetaInvite {
  id                String    @id @default(uuid())
  tokenHash         String    @unique
  email             String?
  maxRedemptions    Int       @default(1)
  redemptionCount   Int       @default(0)
  expiresAt         DateTime
  revokedAt         DateTime?
  redeemedAt        DateTime?
  redeemedByUserId  String?   @unique
  redeemedByUser    User?     @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redemptions       BetaInviteRedemption[]
  createdAt         DateTime  @default(now())

  @@index([expiresAt])
  @@index([email])
  @@map("beta_invites")
}

// Chaque inscription par un lien de campagne est conservée côté serveur pour
// afficher les jauges admin. Le jeton reste uniquement stocké sous forme de
// hash dans BetaInvite.
model BetaInviteRedemption {
  id           String     @id @default(uuid())
  betaInviteId String
  betaInvite   BetaInvite @relation(fields: [betaInviteId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt   DateTime   @default(now())

  @@unique([betaInviteId, userId])
  @@index([betaInviteId, redeemedAt])
  @@map("beta_invite_redemptions")
}

model BookmakerScanProfile {
  id            String                 @id @default(uuid())
  bookmaker     String                 @unique
  supportStatus BookmakerSupportStatus @default(UNTESTED)
  rules         String?
  examples      Json?
  version       Int                    @default(1)
  updatedAt     DateTime               @updatedAt
  history       BookmakerScanProfileVersion[]

  @@map("bookmaker_scan_profiles")
}

// Instantanés immuables des profils. Ils rendent chaque changement de règles,
// exemples ou statut auditable sans exposer les captures au navigateur.
model BookmakerScanProfileVersion {
  id                     String                 @id @default(uuid())
  bookmakerScanProfileId String
  bookmakerScanProfile   BookmakerScanProfile   @relation(fields: [bookmakerScanProfileId], references: [id], onDelete: Cascade)
  version                Int
  supportStatus          BookmakerSupportStatus
  rules                  String?
  examples               Json?
  createdAt              DateTime               @default(now())

  @@unique([bookmakerScanProfileId, version])
  @@index([bookmakerScanProfileId, createdAt])
  @@map("bookmaker_scan_profile_versions")
}

// Créé seulement après consentement explicite. Les JSON contiennent les
// extractions/corrections, jamais des clés, cookies ou sessions.
model ScanQualityReport {
  id                  String                  @id @default(uuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankrollId          String?
  bankroll            Bankroll?               @relation(fields: [bankrollId], references: [id], onDelete: SetNull)
  bookmaker           String
  detectedBookmaker   String?
  detectionConfidence Float?
  status              ScanQualityReportStatus @default(NEW)
  issueType           ScanQualityIssueType    @default(INCORRECT)
  issueDetails        String?
  model               String
  promptVersion       String
  rawExtraction       Json
  finalExtraction     Json
  correctionCount     Int                     @default(0)
  correctionTypes     Json?
  storagePath         String
  consentedAt         DateTime
  expiresAt           DateTime
  adminNotes          String?
  createdAt           DateTime                @default(now())
  reviewedAt          DateTime?

  @@index([userId, createdAt])
  @@index([bookmaker, status, createdAt])
  @@index([expiresAt])
  @@map("scan_quality_reports")
}

// ------------------------------------------------------------
// Retours bêta envoyés depuis l'application
// ------------------------------------------------------------
// La table n'est jamais lue ou écrite depuis le navigateur : les actions
// serveur authentifiées gardent le contrôle d'accès, tandis que la RLS
// bloque tout accès accidentel via la Data API Supabase.
model Feedback {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  FeedbackCategory @default(BUG)
  message   String
  page      String?
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("feedbacks")
}

enum FeedbackCategory {
  BUG
  IDEA
  OTHER
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  CLOSED
}

// ------------------------------------------------------------
// Insight IA (analyse générée, mise en cache — cf. le cooldown de
// 12h dans l'artifact pour maîtriser le coût des appels API)
// ------------------------------------------------------------
model Insight {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  data                  Json     // { appreciation, points_forts, points_amelioration, recommandations }
  generatedAt           DateTime
  betsCountAtGeneration  Int

  @@map("insights")
}
