# Copier ce fichier en .env.local et remplir avec les vraies valeurs
# (Supabase Dashboard > Project Settings > Database / API)

# Connexion poolée (PgBouncer, port 6543) — utilisée par l'app au runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432) — utilisée uniquement par `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Project Settings > API > secret keys (ne jamais exposer côté client, pas de préfixe NEXT_PUBLIC_)
SUPABASE_SECRET_KEY="sb_secret_..."

# Clé API Claude pour le scan de tickets — serveur uniquement, jamais NEXT_PUBLIC_
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Abonnement Premium (Stripe) — mode test d'abord (clés sk_test_/whsec_...)
# Dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard > Developers > Webhooks (ou `stripe listen` en local, qui affiche
# son propre whsec_ différent de celui du Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Dashboard > Product catalog > le Prix récurrent annuel Premium
STRIPE_PRICE_ID_PREMIUM="price_..."

# URL absolue de l'app — nécessaire pour les success_url/cancel_url/return_url
# Stripe (qui exigent des URLs absolues, pas relatives)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
