# Copier ce fichier en .env.local et remplir avec les vraies valeurs
# (Supabase Dashboard > Project Settings > Database / API)

# Connexion poolée (PgBouncer, port 6543) — utilisée par l'app au runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432) — utilisée uniquement par `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Project Settings > API > secret keys (ne jamais exposer côté client, pas de préfixe NEXT_PUBLIC_)
SUPABASE_SECRET_KEY="sb_secret_..."

# IA pour le scan de tickets et les insights — serveur uniquement, jamais NEXT_PUBLIC_.
# Google est prioritaire pour le scan et AI Insight lorsqu'une clé est configurée.
# https://console.anthropic.com/ → API Keys
# ANTHROPIC_API_KEY="sk-ant-..."
# Anthropic reste disponible si la clé Google est absente.
GOOGLE_API_KEY="AIza..."
GEMINI_SCAN_MODEL="gemini-3.6-flash"
GEMINI_INSIGHTS_MODEL="gemini-3.5-flash-lite"

# Abonnement Premium (Stripe) — mode test d'abord (clés sk_test_/whsec_...)
# Dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard > Developers > Webhooks (ou `stripe listen` en local, qui affiche
# son propre whsec_ différent de celui du Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Identifiants du bac à sable Kalivoa. Utiliser ses propres clés de test.
# Recréer séparément les objets et les identifiants lors du passage en production.
STRIPE_ACCOUNT_ID="acct_1T7igFDNFQcoJN1N"
STRIPE_PRODUCT_ID_PREMIUM="prod_VPLWyVsno2M2CM"
STRIPE_PRICE_ID_PREMIUM_MONTHLY="price_1UOWpQDNFQcoJN1NuaUzuhfJ"
STRIPE_PRICE_ID_PREMIUM_YEARLY="price_1UOWpQDNFQcoJN1NUbukzz28"
STRIPE_WELCOME_COUPON_MONTHLY="kalivoa_welcome_monthly_v2"
STRIPE_WELCOME_COUPON_YEARLY="kalivoa_welcome_yearly_v2"
STRIPE_PORTAL_CONFIGURATION_ID="bpc_1UOWvoDNFQcoJN1NlRcrI7Pf"
# Webhooks : checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created/updated/deleted, invoice.paid/payment_failed.

# Parrainage utilisateur — en pause pendant le P0. Les invitations bêta admin
# sont indépendantes et restent actives. Mettre explicitement "true" pour réactiver.
BETA_REFERRAL_ENABLED="false"
# Liste bêta historique, en complément de l'éligibilité conservée en base.
# Offre : 2,99 EUR/mois pendant 12 mois ou 24,99 EUR la première année.
# Les 15 premiers nouveaux comptes après la bêta sont reconnus automatiquement.
# Activation avant le 31 décembre 2026 à 23 h 59 (Paris).
# La variable doit aussi être configurée dans Vercel. Laisser vide hors bêta.
BETA_TESTER_EMAILS="beta@example.com"

# URL absolue de l'app — nécessaire pour les success_url/cancel_url/return_url
# Stripe (qui exigent des URLs absolues, pas relatives)
# En local, remplacez ponctuellement par http://localhost:3000. En production,
# kalivoa.com est l'origine canonique : les liens Stripe, SEO et e-mails y pointent.
NEXT_PUBLIC_APP_URL="https://kalivoa.com"

# Administration : liste d'e-mails autorisés, séparés par des virgules.
# À configurer aussi dans Vercel, sans préfixe NEXT_PUBLIC_.
ADMIN_EMAILS="jeremy.belaud@gmail.com"

# Retention des captures consenties : Vercel Cron appelle chaque jour cette
# route avec cette valeur dans l'en-tête Authorization. Utiliser une valeur
# longue et aléatoire ; ne jamais la préfixer par NEXT_PUBLIC_.
CRON_SECRET="replace-with-a-long-random-secret"

# Canal Discord privé dédié aux signalements de scans bêta. Créez un webhook
# dans Discord (Paramètres du salon > Intégrations) et ne l'exposez jamais au client.
DISCORD_SCAN_FEEDBACK_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Enable only after commercial-records migration; paid launch remains controlled by beta.
COMMERCIAL_RECORDS_ENABLED=false
# Requires active FR domestic registration, inclusive prices and verified tax code.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRODUCT_TAX_CODE=txcd_10103000
# Configure a verified sending domain; never paste the secret in the chat.
TRANSACTIONAL_EMAIL_FROM=Kalivoa <notifications@kalivoa.com>

# Delivery notifications must use a verified signed Resend webhook.
RESEND_WEBHOOK_SECRET=
# Keep destructive account cleanup off until the notice/delivery and restoration checks pass.
ACCOUNT_RETENTION_DELETION_ENABLED=false

# Final legal release and verified email delivery required for public paid launch.
BILLING_LEGAL_READY=false

# Dedicated commercial Preview only: requires the exact isolated Neon host,
# Kalivoa sandbox, current Vercel origin and simulated delivery recipient.
BILLING_RECIPE_ENABLED=false
BILLING_RECIPE_DATABASE_HOST=
BILLING_RECIPE_DATABASE_NAME=
TRANSACTIONAL_EMAIL_TEST_RECIPIENT=
