# Copier ce fichier en .env.local et remplir avec les vraies valeurs
# (Supabase Dashboard > Project Settings > Database / API)

# Connexion poolée (PgBouncer, port 6543) — utilisée par l'app au runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432) — utilisée uniquement par `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Project Settings > API > secret keys (ne jamais exposer côté client, pas de préfixe NEXT_PUBLIC_)
SUPABASE_SECRET_KEY="sb_secret_..."

# IA pour le scan de tickets et les insights — serveur uniquement, jamais NEXT_PUBLIC_.
# Anthropic est prioritaire pour le scan lorsqu'une clé est configurée.
# https://console.anthropic.com/ → API Keys
# ANTHROPIC_API_KEY="sk-ant-..."
# Google AI Studio reste utilisé pour le scan lorsque Anthropic est absent,
# et demeure le fournisseur prioritaire des insights.
GOOGLE_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.5-flash-lite"

# Abonnement Premium (Stripe) — mode test d'abord (clés sk_test_/whsec_...)
# Dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard > Developers > Webhooks (ou `stripe listen` en local, qui affiche
# son propre whsec_ différent de celui du Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Dashboard > Product catalog > le Prix récurrent annuel Premium
STRIPE_PRICE_ID_PREMIUM="price_..."
# Coupon de 10 EUR sur la première facture, réservé aux bêta-testeurs.
# Il est passé par le serveur à Checkout, jamais affiché comme code public.
STRIPE_BETA_COUPON_ID="bettrack_beta_first_year"

# Parrainage utilisateur — en pause pendant le P0. Les invitations bêta admin
# sont indépendantes et restent actives. Mettre explicitement "true" pour réactiver.
BETA_REFERRAL_ENABLED="false"
# Liste d'e-mails éligibles à l'offre à 9,99 EUR la première année.
# La variable doit aussi être configurée dans Vercel. Laisser vide hors bêta.
BETA_TESTER_EMAILS="beta@example.com"

# URL absolue de l'app — nécessaire pour les success_url/cancel_url/return_url
# Stripe (qui exigent des URLs absolues, pas relatives)
# En local, remplacez ponctuellement par http://localhost:3000. En production,
# kalivoa.com est l'origine canonique : les liens Stripe, SEO et e-mails y pointent.
NEXT_PUBLIC_APP_URL="https://kalivoa.com"

# Administration : liste d'e-mails autorisés, séparés par des virgules.
# À configurer aussi dans Vercel, sans préfixe NEXT_PUBLIC_.
ADMIN_EMAILS="jeremy.belaud@gmail.com"

# Retention des captures consenties : Vercel Cron appelle chaque jour cette
# route avec cette valeur dans l'en-tête Authorization. Utiliser une valeur
# longue et aléatoire ; ne jamais la préfixer par NEXT_PUBLIC_.
CRON_SECRET="replace-with-a-long-random-secret"

# Canal Discord privé dédié aux signalements de scans bêta. Créez un webhook
# dans Discord (Paramètres du salon > Intégrations) et ne l'exposez jamais au client.
DISCORD_SCAN_FEEDBACK_WEBHOOK_URL="https://discord.com/api/webhooks/..."
